 "dialogue": {
  "title": {
   "bo": "ལམ་ཁར་ཐུག་པ།",
   "en": "Meeting on the road"
  },
  "turns": [
   {
    "who": "བཀྲ་ཤིས",
    "bo": "བཀྲ་ཤིས་བདེ་ལེགས། ཁྱེད་རང་སྐུ་གཟུགས་བདེ་པོ་ཡིན་པས།",
    "en": "Hello! How are you?"
   },
   {
    "who": "པདྨ",
    "bo": "བདེ་པོ་ཡིན། ཐུགས་རྗེ་ཆེ། ཁྱེད་རང་གི་མཚན་ལ་ག་རེ་ཞུ་གི་ཡོད།",
    "en": "I'm well, thank you. What is your name?"
   },
   {
    "who": "བཀྲ་ཤིས",
    "bo": "ངའི་མིང་ལ་བཀྲ་ཤིས་ཟེར། ཁྱེད་རང་གི་མཚན་ལ་ག་རེ་ཞུ་གི་ཡོད།",
    "en": "My name is Tashi. What is yours?"
   },
   {
    "who": "པདྨ",
    "bo": "ངའི་མིང་ལ་པདྨ་ཟེར། ཁྱེད་རང་ག་ནས་ཕེབས་པ་ཡིན།",
    "en": "My name is Pema. Where are you from?"
   },
   {
    "who": "བཀྲ་ཤིས",
    "bo": "ང་ལྷ་ས་ནས་ཡིན།",
    "en": "I'm from Lhasa."
   },
   {
    "who": "པདྨ",
    "bo": "ཡག་པོ་རེད། ཡང་བསྐྱར་མཇལ་ཡོང་། ག་ལེར་བཞུགས།",
    "en": "Lovely. See you again. Goodbye!"
   },
   {
    "who": "བཀྲ་ཤིས",
    "bo": "ལགས། ག་ལེར་ཕེབས།",
    "en": "Yes. Goodbye!"
   }
  ]
 },
